# Alex LLM Configuration
# Copy this file to .env and fill in your actual values.

# LLM provider (deepseek, openai, anthropic)
ALEX_PROVIDER=deepseek

# API key for the provider
ALEX_API_KEY=sk-your-api-key-here

# Base URL for the provider API
ALEX_BASE_URL=https://api.deepseek.com

# Model name
ALEX_MODEL=deepseek-chat

# Context window in tokens (K=1024, M=1048576; default 128K = 131072)
# ALEX_CONTEXT_TOKENS=128K

# Max output tokens (optional, default: 4096; supports 64K)

# ALEX_MAX_TOKENS=4096

# Temperature (optional, default: 0.0)
# ALEX_TEMPERATURE=0.0
# Compact when provider prompt pressure exceeds this fraction of the context window
# ALEX_COMPACT_THRESHOLD=0.8

# Thinking/reasoning switch (on/off) and effort (low/high/max)
# ALEX_THINKING=on
# ALEX_EFFORT=high
