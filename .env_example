# Alex LLM Configuration
# Copy this file to .env and fill in your actual values.

# LLM provider (deepseek, openai, anthropic)
ALEX_PROVIDER=deepseek

# API key for the provider
ALEX_API_KEY=sk-your-api-key-here

# Base URL for the provider API
ALEX_BASE_URL=https://api.deepseek.com

# Model name
ALEX_MODEL=deepseek-chat

# Max tokens (optional, default: 4096)
# ALEX_MAX_TOKENS=4096

# Temperature (optional, default: 0.0)
# ALEX_TEMPERATURE=0.0